{
    "name": "rrq/dukpay",
    "description": "Laravel payment provider for the DukPay Merchant API (Security Authentication V2: RSA2 signatures + RSA-OAEP/AES-256-GCM hybrid encryption).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "dukpay", "payment", "payment-gateway", "payin"],
    "authors": [
        {
            "name": "Kiki Kurniawan",
            "email": "kiki.kurniawan@teamrrq.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "phpseclib/phpseclib": "^3.0.36"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rrq\\Dukpay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rrq\\Dukpay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rrq\\Dukpay\\DukPayServiceProvider"
            ],
            "aliases": {
                "DukPay": "Rrq\\Dukpay\\Facades\\DukPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
